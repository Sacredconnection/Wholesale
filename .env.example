# ── WooCommerce headless backend ──────────────────────────────────
# Base URL of the WordPress/WooCommerce install.
# This will change when the backend moves — update it here and on Vercel.
WOOCOMMERCE_URL=https://backend-wholesale.sacred-snuff.com

# REST API keys — generate in WP Admin: WooCommerce > Settings > Advanced > REST API.
# The Sacred Connection key requires "Read/Write" permission because the portal reads the catalog and creates orders.
# These are SERVER-ONLY secrets (no NEXT_PUBLIC_ prefix) and never reach the browser.
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: how long (seconds) the server caches WooCommerce responses. Default: 300.
WC_REVALIDATE_SECONDS=300
# Optional timeout for each upstream WooCommerce request in milliseconds. Default: 15000.
WC_REQUEST_TIMEOUT_MS=15000

# Optional but recommended in production: shared secret used to verify product
# created/updated/deleted webhooks sent to /api/webhooks/woocommerce. PDF exports
# always bypass the cache; this webhook also refreshes the on-screen catalog immediately.
WC_WEBHOOK_SECRET=

# Transactional approval emails. RESEND_API_KEY and a sender on a domain
# verified in Resend are required. PORTAL_URL is used by the approval button.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=Sacred Connection Wholesale <wholesale@sacredconnection.co>
TRANSACTIONAL_EMAIL_REPLY_TO=info@sacredconnection.co
PORTAL_URL=https://wholesale.sacred-snuff.com

# WordPress admin Application Password — used to flag newly registered
# accounts with the "pending" role and to store partner profile photos in the
# WordPress media library. Generate it in WP Admin > Users > Profile >
# Application Passwords. Profile photo upload is unavailable without it.
WP_ADMIN_USER=
WP_APP_PASSWORD=

# Required: signs the HttpOnly authentication cookie. Generate a unique value
# with at least 32 random characters (for example: openssl rand -base64 48).
# Never prefix this variable with NEXT_PUBLIC_.
SESSION_SECRET=

# Server-only text appended to new wholesale orders. Keep banking/payment data
# in Vercel Environment Variables instead of committing it to the repository.
# Use \n for line breaks when entering a single-line environment value.
ORDER_CUSTOMER_NOTE=

# Comma-separated WordPress roles allowed to use the wholesale portal.
# If omitted, the application uses its conservative built-in allowlist.
WHOLESALE_ALLOWED_ROLES=new customer,special customer,old customer,wholesale customer,wholesale buyer,shop manager,administrator

# Recommended for multi-instance/serverless production deployments. The app
# falls back to an in-process limiter when these are absent, but that fallback
# cannot coordinate limits or idempotency across multiple instances.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# The Vercel Upstash integration may inject equivalent names automatically:
# RATE_LIMIT_REDIS_REST_KV_REST_API_URL
# RATE_LIMIT_REDIS_REST_KV_REST_API_TOKEN
