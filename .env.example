# ── WooCommerce headless backend ──────────────────────────────────
# Base URL of the WordPress/WooCommerce install.
# This will change when the backend moves — update it here and on Vercel.
WOOCOMMERCE_URL=https://wholesale.sacred-snuff.com

# REST API keys — generate in WP Admin: WooCommerce > Settings > Advanced > REST API.
# "Read" permission is enough for the catalog; use "Read/Write" if orders will be created.
# These are SERVER-ONLY secrets (no NEXT_PUBLIC_ prefix) and never reach the browser.
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: how long (seconds) the server caches WooCommerce responses. Default: 300.
WC_REVALIDATE_SECONDS=300

# WordPress admin Application Password — used only to flag newly registered
# accounts with the "pending" role in WP Admin (WC's customer API can't set
# roles). Generate in WP Admin > Users > Profile > Application Passwords.
# Optional: without it, new accounts land as "Customer" but are still blocked
# from signing in until approved.
WP_ADMIN_USER=
WP_APP_PASSWORD=

# Required: signs the HttpOnly authentication cookie. Generate a unique value
# with at least 32 random characters (for example: openssl rand -base64 48).
# Never prefix this variable with NEXT_PUBLIC_.
SESSION_SECRET=

# Server-only text appended to new wholesale orders. Keep banking/payment data
# in Vercel Environment Variables instead of committing it to the repository.
# Use \n for line breaks when entering a single-line environment value.
ORDER_PAYMENT_INSTRUCTIONS=
